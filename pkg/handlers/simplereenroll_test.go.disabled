package handlers

import (
	"bytes"
	"context"
	"crypto/rand"
	"crypto/rsa"
	"crypto/tls"
	"crypto/x509"
	"crypto/x509/pkix"
	"encoding/base64"
	"log/slog"
	"math/big"
	"net/http"
	"net/http/httptest"
	"testing"
	"time"

	"github.com/mabunixda/est-service/pkg/auth"
	"github.com/mabunixda/est-service/pkg/backend"
)

func TestSimpleReenrollHandler(t *testing.T) {
	backendMock := &mockBackendHandlers{}
	authMgr := auth.NewManager(&auth.Config{
		EnabledMethods: []string{"basic"},
		UserpassConfig: &auth.UserpassConfig{
			Enabled: true,
		},
	}, backendMock, slog.Default())

	config := &EnrollmentConfig{
		PKIMount:   "pki",
		PKIRole:    "est",
		MaxCSRSize: 10 * 1024 * 1024,
	}

	handler := NewSimpleReenrollHandler(
		&backend.Client{Backend: backend},
		authMgr,
		config,
		slog.Default(),
		&mockTelemetry{},
	)

	csrDER, _, err := generateTestCSR()
	if err != nil {
		t.Fatalf("Failed to generate test CSR: %v", err)
	}

	csrB64 := base64.StdEncoding.EncodeToString(csrDER)

	tests := []struct {
		name           string
		method         string
		body           string
		auth           string
		expectedStatus int
	}{
		{
			name:           "successful reenrollment with basic auth",
			method:         "POST",
			body:           csrB64,
			auth:           "Basic " + base64.StdEncoding.EncodeToString([]byte("testuser:testpass")),
			expectedStatus: http.StatusOK,
		},
		{
			name:           "missing authentication",
			method:         "POST",
			body:           csrB64,
			auth:           "",
			expectedStatus: http.StatusUnauthorized,
		},
		{
			name:           "invalid method",
			method:         "GET",
			body:           "",
			auth:           "Basic " + base64.StdEncoding.EncodeToString([]byte("testuser:testpass")),
			expectedStatus: http.StatusMethodNotAllowed,
		},
		{
			name:           "invalid CSR",
			method:         "POST",
			body:           "invalid-base64",
			auth:           "Basic " + base64.StdEncoding.EncodeToString([]byte("testuser:testpass")),
			expectedStatus: http.StatusBadRequest,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			req := httptest.NewRequest(tt.method, "/.well-known/est/simplereenroll", bytes.NewReader([]byte(tt.body)))
			if tt.auth != "" {
				req.Header.Set("Authorization", tt.auth)
			}
			req.Header.Set("Content-Type", "application/pkcs10")

			w := httptest.NewRecorder()
			handler.ServeHTTP(w, req)

			if w.Code != tt.expectedStatus {
				t.Errorf("Status = %d, want %d", w.Code, tt.expectedStatus)
			}

			if w.Code == http.StatusOK {
				contentType := w.Header().Get("Content-Type")
				if contentType != "application/pkcs7-mime; smime-type=certs-only" {
					t.Errorf("Content-Type = %s, want application/pkcs7-mime", contentType)
				}
			}
		})
	}
}

func TestSimpleReenrollWithCertAuth(t *testing.T) {
	// Generate client certificate and key
	clientKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		t.Fatalf("Failed to generate client key: %v", err)
	}

	clientCertTemplate := &x509.Certificate{
		SerialNumber: big.NewInt(2),
		Subject: pkix.Name{
			CommonName: "client.example.com",
		},
		NotBefore:   time.Now(),
		NotAfter:    time.Now().Add(365 * 24 * time.Hour),
		KeyUsage:    x509.KeyUsageDigitalSignature,
		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth},
	}

	clientCertDER, err := x509.CreateCertificate(rand.Reader, clientCertTemplate, clientCertTemplate, &clientKey.PublicKey, clientKey)
	if err != nil {
		t.Fatalf("Failed to create client cert: %v", err)
	}

	clientCert, err := x509.ParseCertificate(clientCertDER)
	if err != nil {
		t.Fatalf("Failed to parse client cert: %v", err)
	}

	backendMock := &mockBackendHandlers{}
	authMgr := auth.NewManager(&auth.Config{
		EnabledMethods: []string{"cert"},
		CertConfig: &auth.CertConfig{
			Enabled: true,
		},
	}, backendMock, slog.Default())

	config := &EnrollmentConfig{
		PKIMount:   "pki",
		PKIRole:    "est",
		MaxCSRSize: 10 * 1024 * 1024,
	}

	handler := NewSimpleReenrollHandler(
		&backend.Client{Backend: backendMock},
		authMgr,
		config,
		slog.Default(),
		&mockTelemetry{},
	)

	// Generate CSR with the same key
	csrTemplate := &x509.CertificateRequest{
		Subject: pkix.Name{
			CommonName: "client.example.com",
		},
	}

	csrDER, err := x509.CreateCertificateRequest(rand.Reader, csrTemplate, clientKey)
	if err != nil {
		t.Fatalf("Failed to create CSR: %v", err)
	}

	csrB64 := base64.StdEncoding.EncodeToString(csrDER)

	req := httptest.NewRequest("POST", "/.well-known/est/simplereenroll", bytes.NewReader([]byte(csrB64)))
	req.Header.Set("Content-Type", "application/pkcs10")

	// Simulate TLS connection with client certificate
	req.TLS = &tls.ConnectionState{
		PeerCertificates: []*x509.Certificate{clientCert},
	}

	w := httptest.NewRecorder()
	handler.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Errorf("Status = %d, want %d. Body: %s", w.Code, http.StatusOK, w.Body.String())
	}
}

func TestSimpleReenrollCSRMismatch(t *testing.T) {
	// Generate client certificate
	clientKey, _ := rsa.GenerateKey(rand.Reader, 2048)
	clientCertTemplate := &x509.Certificate{
		SerialNumber: big.NewInt(2),
		Subject: pkix.Name{
			CommonName: "client.example.com",
		},
		NotBefore:   time.Now(),
		NotAfter:    time.Now().Add(365 * 24 * time.Hour),
		KeyUsage:    x509.KeyUsageDigitalSignature,
		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth},
	}

	clientCertDER, _ := x509.CreateCertificate(rand.Reader, clientCertTemplate, clientCertTemplate, &clientKey.PublicKey, clientKey)
	clientCert, _ := x509.ParseCertificate(clientCertDER)

	backendMock := &mockBackendHandlers{}
	authMgr := auth.NewManager(&auth.Config{
		EnabledMethods: []string{"cert"},
		CertConfig: &auth.CertConfig{
			Enabled: true,
		},
	}, backendMock, slog.Default())

	config := &EnrollmentConfig{
		PKIMount:               "pki",
		PKIRole:                "est",
		MaxCSRSize:             10 * 1024 * 1024,
		ValidateCSRMatchesCert: true, // Enable validation
	}

	handler := NewSimpleReenrollHandler(
		&backend.Client{Backend: backendMock},
		authMgr,
		config,
		slog.Default(),
		&mockTelemetry{},
	)

	// Generate CSR with a DIFFERENT key
	differentKey, _ := rsa.GenerateKey(rand.Reader, 2048)
	csrTemplate := &x509.CertificateRequest{
		Subject: pkix.Name{
			CommonName: "client.example.com",
		},
	}

	csrDER, _ := x509.CreateCertificateRequest(rand.Reader, csrTemplate, differentKey)
	csrB64 := base64.StdEncoding.EncodeToString(csrDER)

	req := httptest.NewRequest("POST", "/.well-known/est/simplereenroll", bytes.NewReader([]byte(csrB64)))
	req.Header.Set("Content-Type", "application/pkcs10")
	req.TLS = &tls.ConnectionState{
		PeerCertificates: []*x509.Certificate{clientCert},
	}

	w := httptest.NewRecorder()
	handler.ServeHTTP(w, req)

	if w.Code != http.StatusBadRequest {
		t.Errorf("Status = %d, want %d for CSR key mismatch", w.Code, http.StatusBadRequest)
	}
}

func TestSimpleReenrollWithBearerToken(t *testing.T) {
	backendMock := &mockBackendHandlers{
		validateTokenFunc: func(ctx context.Context, token string) (bool, error) {
			return token == "valid-token", nil
		},
	}

	authMgr := auth.NewManager(&auth.Config{
		EnabledMethods: []string{"bearer"},
		BearerConfig: &auth.BearerConfig{
			Enabled: true,
		},
	}, backendMock, slog.Default())

	config := &EnrollmentConfig{
		PKIMount:   "pki",
		PKIRole:    "est",
		MaxCSRSize: 10 * 1024 * 1024,
	}

	handler := NewSimpleReenrollHandler(
		&backend.Client{Backend: backendMock},
		authMgr,
		config,
		slog.Default(),
		&mockTelemetry{},
	)

	csrDER, _, _ := generateTestCSR()
	csrB64 := base64.StdEncoding.EncodeToString(csrDER)

	req := httptest.NewRequest("POST", "/.well-known/est/simplereenroll", bytes.NewReader([]byte(csrB64)))
	req.Header.Set("Authorization", "Bearer valid-token")
	req.Header.Set("Content-Type", "application/pkcs10")

	w := httptest.NewRecorder()
	handler.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Errorf("Status = %d, want %d", w.Code, http.StatusOK)
	}
}
